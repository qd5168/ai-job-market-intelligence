generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── 枚举 ─────────────────────────────────────────────────

enum JobSource {
  REMOTEOK
  GREENHOUSE
  LEVER
  ASHBY
  HIMALAYAS
  // V2+: MUST NOT add LINKEDIN / INDEED / GLASSDOOR
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  ANNUAL
}

enum JobStatus {
  ACTIVE
  CLOSED
}

enum AtsSource {
  GREENHOUSE
  LEVER
  ASHBY
}

enum AtsCompanyStatus {
  PENDING_VALIDATION
  ACTIVE
  INACTIVE
}

enum JobDecision {
  APPLY
  MAYBE
  SKIP
}

enum JobEligibility {
  ELIGIBLE
  RESTRICTED
  INELIGIBLE
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

// Job-side only — AI Job Parsing's coarse-bucket output for a posting's
// region restriction (Job.eligibleRegions; empty = no explicit restriction
// found, treated as globally open, not "matches nothing"). Users don't pick
// a bucket directly; UserProfile.currentCountry stores their actual ISO
// 3166-1 country code, mapped to a bucket at scoring time via
// @ai-job-market-intelligence/shared/regions.
enum RegionBucket {
  US
  EU
  UK
  APAC
  LATAM
  REMOTE_GLOBAL
  OTHER
}

enum NotificationChannel {
  EMAIL
  // Phase 2: TELEGRAM, WEBHOOK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// null = never uploaded/linked (distinct from FAILED). PENDING is set
// synchronously by the POST/PUT route before profile_parse is even
// enqueued, so the frontend can show a "processing" state immediately.
enum ParseStatus {
  PENDING
  SUCCESS
  FAILED
}

// Mirrors Stripe's own Invoice.status values.
enum OrderStatus {
  PAID
  OPEN
  VOID
  UNCOLLECTIBLE
}

// ─── Auth.js 必需表 ───────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  emailVerified       DateTime? @map("email_verified")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  // Daily Career Brief is on by default for all users — toggled off from
  // /settings/notifications.
  dailyBriefEnabled   Boolean   @default(true) @map("daily_brief_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  profile             UserProfile?
  careerProfile       CareerProfile?
  subscription        Subscription?
  usageDaily          UsageDaily[]
  jobScores           JobScore[]
  jobApplications     JobApplication[]
  notifications       Notification[]
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  careerBriefs        CareerBrief[]
  careerCoachMessages CareerCoachMessage[]
  agentHandoffs       AgentHandoff[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── 用户画像 ─────────────────────────────────────────────

model UserProfile {
  id                 String                       @id @default(cuid())
  userId             String                       @unique @map("user_id")
  skills             String[]
  experienceYears    Int                          @default(0) @map("experience_years")
  preferredRoles     String[]                     @map("preferred_roles")
  // ISO 3166-1 alpha-2 code — where the user is actually based / has work
  // authorization, not a wishlist. null = not filled in, don't check.
  // Mapped to a RegionBucket at scoring time when needed, see the
  // RegionBucket enum comment above.
  currentCountry     String?                      @map("current_country")
  // Expected minimum annual salary (USD), no currency conversion. null = no
  // salary preference. Compared against a job's normalized annual salary at
  // scoring time as a rule_score deduction.
  expectedSalaryMin  Int?                         @map("expected_salary_min")
  profileEmbedding   Unsupported("vector(2048)")? @map("profile_embedding")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// CareerProfile holds the raw structured output from Resume/GitHub parsing,
// kept separate from UserProfile (the merged skill set used for scoring) so
// users can review/re-parse without losing their manually entered profile.
model CareerProfile {
  id                    String       @id @default(cuid())
  userId                String       @unique @map("user_id")
  resumeSkills          String[]     @map("resume_skills")
  resumeExperienceYears Int?         @map("resume_experience_years")
  resumeSummary         String?      @db.Text @map("resume_summary")
  // Split from a single shared parsedAt so a resume re-upload and a GitHub
  // re-link don't clobber each other's parse state.
  resumeParseStatus     ParseStatus? @map("resume_parse_status")
  resumeParsedAt        DateTime?    @map("resume_parsed_at")
  githubUsername        String?      @map("github_username")
  githubLanguages       Json?        @map("github_languages")
  githubSummary         String?      @db.Text @map("github_summary")
  githubParseStatus     ParseStatus? @map("github_parse_status")
  githubParsedAt        DateTime?    @map("github_parsed_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("career_profiles")
}

// ─── 公司（jobs.company 从纯字符串升级为实体） ────────────

model Company {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  jobs Job[]

  @@map("companies")
}

// ─── 职位（平台级） ───────────────────────────────────────

model Job {
  id               String        @id @default(cuid())
  externalId       String        @map("external_id")
  source           JobSource
  companyId        String?       @map("company_id")
  title            String
  company          String
  role             String?
  level            String?
  // AI Job Parsing's normalized skill names (lowercase, deduped, synonym-
  // mapped) — sourceStructured sources use extractTagsAsSkills on their tags
  // instead of an LLM call.
  skills           String[]      @default([])
  salaryMin        Int?          @map("salary_min")
  salaryMax        Int?          @map("salary_max")
  // Only sourceStructured sources (Himalayas) set these — everything else
  // stays null (frontend assumes annual USD).
  salaryCurrency   String?       @map("salary_currency")
  salaryPeriod     SalaryPeriod? @map("salary_period")
  remote           Boolean       @default(true)
  parseConfidence  Float?        @map("parse_confidence")
  // true = AI Job Parsing was skipped because the source already provides
  // structured fields natively.
  sourceStructured Boolean       @default(false) @map("source_structured")
  // SHA-256 fingerprint used to skip re-parsing/re-embedding unchanged
  // postings on a later crawl.
  contentHash      String?       @map("content_hash")
  // Only Greenhouse/Lever/Ashby (per-company sources) can detect closure —
  // aggregator sources never set this to CLOSED.
  status           JobStatus     @default(ACTIVE)
  closedAt         DateTime?     @map("closed_at")
  alsoSeenOn       JobSource[]   @default([]) @map("also_seen_on")
  description      String        @db.Text
  url              String
  location         String        @default("Remote")
  // ISO 3166-1 alpha-2, deterministically string-matched from `location`
  // (or Himalayas' locationRestrictions) — null when zero or multiple
  // countries are found. More precise than eligibleRegions and takes
  // priority over it for R4 region-preference scoring.
  locationCountry  String?       @map("location_country")
  // AI Job Parsing's extracted region restriction — empty = no explicit
  // restriction found (globally open).
  eligibleRegions  RegionBucket[] @default([]) @map("eligible_regions")
  tags             String[]
  postedAt         DateTime?     @map("posted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  companyRef    Company?          @relation(fields: [companyId], references: [id])
  embedding     JobEmbedding?
  scores        JobScore[]
  applications  JobApplication[]
  notifications Notification[]

  @@unique([source, externalId])
  @@index([createdAt(sort: Desc)])
  @@index([postedAt(sort: Desc)])
  @@index([role])
  @@index([status])
  @@map("jobs")
}

// Company Discovery results, validated against the ATS's own official API
// before being marked ACTIVE. Replaces the old
// GREENHOUSE_COMPANY_SLUGS/LEVER_COMPANY_SLUGS/ASHBY_COMPANY_SLUGS static
// whitelist env vars — ingestion_collect reads ACTIVE rows from here.
model AtsCompany {
  id                  String           @id @default(cuid())
  slug                String
  source              AtsSource
  companyName         String?          @map("company_name")
  status              AtsCompanyStatus @default(PENDING_VALIDATION)
  cadenceBucket       Int              @map("cadence_bucket")
  consecutiveFailures Int              @default(0) @map("consecutive_failures")
  discoveredAt        DateTime         @default(now()) @map("discovered_at")
  lastCheckedAt       DateTime?        @map("last_checked_at")
  lastSuccessAt       DateTime?        @map("last_success_at")

  @@unique([source, slug])
  @@index([source, status, cadenceBucket])
  @@map("ats_companies")
}

model JobEmbedding {
  id        String                      @id @default(cuid())
  jobId     String                      @unique @map("job_id")
  embedding Unsupported("vector(2048)")
  model     String                      @default("nvidia/llama-nemotron-embed-vl-1b-v2:free")
  createdAt DateTime                    @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_embeddings")
}

// ─── 评分（用户级） ───────────────────────────────────────

model JobScore {
  id             String         @id @default(cuid())
  jobId          String         @map("job_id")
  userId         String         @map("user_id")
  score          Int
  decision       JobDecision
  // Historical rows (written before this field existed) land on this
  // default, which happens to match its intended meaning for them too:
  // "eligibility unknown" for scores computed under the old fixed-penalty
  // R4 that never recorded eligibility as its own signal.
  eligibility    JobEligibility @default(RESTRICTED)
  reasoning      String         @db.Text
  strengths      String[]       @default([]) @map("strengths")
  skillGap       String[]       @default([]) @map("skill_gap")
  llmScore       Float          @map("llm_score")
  embeddingScore Float          @map("embedding_score")
  ruleScore      Float          @map("rule_score")
  scoringVersion String         @default("v4.1") @map("scoring_version")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId, score(sort: Desc)])
  @@index([userId, decision])
  @@index([userId, eligibility])
  @@map("job_scores")
}

// User-tracked application status — purely local bookkeeping, never synced
// to any external platform (sources don't expose an apply/employer contact
// API). Kept in its own table rather than folded into JobScore: JobScore
// rows are upserted wholesale on every rescore (including the §8.7 score
// smoothing), and a merged table would risk the application fields getting
// clobbered by that upsert.
model JobApplication {
  id        String            @id @default(cuid())
  jobId     String            @map("job_id")
  userId    String            @map("user_id")
  status    ApplicationStatus
  note      String?           @db.Text
  // First-marked time — does not change on later status updates.
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId, status])
  @@map("job_applications")
}

// ─── 通知 ─────────────────────────────────────────────────

model Notification {
  id        String              @id @default(cuid())
  userId    String              @map("user_id")
  jobId     String              @map("job_id")
  channel   NotificationChannel
  status    NotificationStatus  @default(PENDING)
  sentAt    DateTime?           @map("sent_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId, channel])
  @@index([status])
  @@map("notifications")
}

// ─── 订阅（B2C，绑 User） ─────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// 🆕 Order history — one row per Stripe invoice.payment_succeeded webhook
// event, shown on /settings/billing. Populated by the Stripe webhook handler,
// not fetched live from Stripe on page load (keeps the billing page fast and
// working even if Stripe is briefly unreachable).
model Order {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")
  stripeInvoiceId String      @unique @map("stripe_invoice_id")
  amount          Int         // smallest currency unit (cents for USD), matches Stripe's own amount_paid
  currency        String
  status          OrderStatus
  description     String?
  invoiceUrl      String?     @map("invoice_url")
  createdAt       DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("orders")
}

model UsageDaily {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  date                    DateTime @db.Date
  scoreCount              Int      @default(0) @map("score_count")
  careerCoachMessageCount Int      @default(0) @map("career_coach_message_count")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("usage_daily")
}

// ─── Skill Intelligence（核心趋势计算） ─────────────────────

model Skill {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  trendSnapshots SkillTrendSnapshot[]

  @@map("skills")
}

model SkillTrendSnapshot {
  id            String   @id @default(cuid())
  skillId       String   @map("skill_id")
  windowDays    Int      @map("window_days")
  periodEnd     DateTime @map("period_end")
  jobCount      Int      @map("job_count")
  // null when the prior same-length window has no data yet or the sample
  // size is too small (< 20) to compute a meaningful growth rate — jobCount
  // itself is always computed.
  growthPercent Float?   @map("growth_percent")
  createdAt     DateTime @default(now()) @map("created_at")

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, windowDays, periodEnd])
  @@index([windowDays, periodEnd, growthPercent(sort: Desc)])
  @@map("skill_trend_snapshots")
}

// ─── AI Career Agent ───────────────────────────────────────

model CareerBrief {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  briefDate DateTime @db.Date @map("brief_date")
  // { marketHighlights, recommendedJobs, recommendedSkill } — structured,
  // no LLM call.
  summary   Json
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, briefDate])
  @@map("career_briefs")
}

enum ChatRole {
  USER
  ASSISTANT
}

model CareerCoachMessage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("career_coach_messages")
}

// ─── Multi-agent workflow: agent-to-agent handoff record ──
//
// Records the Opportunity Discovery -> Career Coach handoff event — both
// runtime state and the data source for visualizing agent collaboration.

enum AgentType {
  OPPORTUNITY_DISCOVERY
  CAREER_COACH
}

model AgentHandoff {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  fromAgent   AgentType @map("from_agent")
  toAgent     AgentType @map("to_agent")
  context     Json // { jobId, matchScore, reason }
  triggeredAt DateTime  @default(now()) @map("triggered_at")
  // When the receiving agent actually processed this handoff — null = pending.
  consumedAt  DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, triggeredAt(sort: Desc)])
  @@map("agent_handoffs")
}

// ─── B2B Career Coach API: API key auth ───────────────────
//
// No customer/billing tables — API keys are purely an auth/rate-limit
// identity, not tied to a subscription or invoice.

model ApiKey {
  id         String    @id @default(cuid())
  label      String
  keyHash    String    @unique @map("key_hash")
  scopes     String[]  @default(["career-coach:read", "career-coach:write"])
  active     Boolean   @default(true)
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

