{
  "name": "ai-job-market-intelligence",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @ai-job-market-intelligence/web exec playwright test",
    "db:migrate": "pnpm --filter @ai-job-market-intelligence/db exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @ai-job-market-intelligence/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @ai-job-market-intelligence/db exec prisma db seed",
    "db:studio": "pnpm --filter @ai-job-market-intelligence/db exec prisma studio",
    "db:reset": "pnpm --filter @ai-job-market-intelligence/db exec prisma migrate reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.10.9",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
