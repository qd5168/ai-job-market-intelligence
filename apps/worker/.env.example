# ─── App ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── Database ──────────────────────────────────────
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI (OpenRouter, cost-first) ────────────
# Job Parsing/Scoring/Resume/GitHub parsing/Embedding all run in this app —
# Career Coach is the only OpenRouter-calling code that doesn't, see
# apps/web/.env.example for its (separate) model config.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# MUST be explicit: the embedding column is vector(2048), the model must
# output 2048-dim vectors or embedding writes fail with a dimension mismatch
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# CHAT_MODEL=google/gemma-4-26b-a4b-it:free
# Optional paid fallback model for Job Parsing/Scoring/Resume/GitHub
# parsing. Unset = fallback disabled, behavior
# identical to not having this feature at all. 2026-08 pricing snapshot
# picked for cost — verify current pricing/availability at
# openrouter.ai/models before relying on it.
CHAT_MODEL_FALLBACK=qwen/qwen3-30b-a3b-instruct-2507  # structured extraction, no reasoning overhead, $0.048/$0.193 per M tokens
# Shared with apps/web's own budget check — each process reads its own copy
# of this var.
OPENROUTER_FALLBACK_MIN_BALANCE_USD=1

# ─── Email (Resend) ───────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Ingestion ───────────────────
REMOTEOK_USER_AGENT=AI-Job-Market-Intelligence/1.0 (contact@yourdomain.com)

# ─── Company Discovery ──
COMPANY_DISCOVERY_TARGET_COMPANY_COUNT=1500
